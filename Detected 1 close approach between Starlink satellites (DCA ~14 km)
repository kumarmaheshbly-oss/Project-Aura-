# SGP4 objects banao
sats = []
for sat in satellites:
    try:
        s = Satrec.twoline2rv(sat["line1"], sat["line2"])
        sats.append({"name": sat["name"], "obj": s})
    except Exception as e:
        pass

print(f"Successfully initialized: {len(sats)} satellites")

# Current time
now = datetime.utcnow()
jd, fr = jday(now.year, now.month, now.day, now.hour, now.minute, now.second)

# Positions calculate karo
positions = {}
for s in sats:
    error, pos, vel = s["obj"].sgp4(jd, fr)
    if error == 0:
        positions[s["name"]] = {"pos": pos, "vel": vel}

print(f"Positions calculated: {len(positions)}")
print("=" * 80)

# Collision analysis
names = list(positions.keys())
risk_count = 0
close_pairs = []
total_pairs = 0

start_time = time.time()

for i in range(len(names)):
    for j in range(i+1, len(names)):
        total_pairs += 1
        p1 = positions[names[i]]["pos"]
        v1 = positions[names[i]]["vel"]
        p2 = positions[names[j]]["pos"]
        v2 = positions[names[j]]["vel"]
        
        result = calculate_collision_risk(p1, v1, p2, v2)
        if result:
            tca, dca = result
            if dca < 10:
                risk_count += 1
                close_pairs.append((names[i], names[j], tca, dca, "COLLISION RISK"))
            elif dca < 50:
                close_pairs.append((names[i], names[j], tca, dca, "WARNING"))

elapsed = time.time() - start_time

# Results sort karo
close_pairs.sort(key=lambda x: x[3])

print(f"Total pairs analyzed: {total_pairs}")
print(f"Computation time: {elapsed:.2f} seconds")
print("=" * 80)
print("CLOSE APPROACHES (DCA < 50 km):")
print("-" * 80)

if close_pairs:
    for pair in close_pairs:
        print(f"{pair[4]}: {pair[0]} <-> {pair[1]}")
        print(f"   TCA: {pair[2]:.2f} sec | DCA: {pair[3]:.2f} km")
        print()
else:
    print("No close approaches found (all pairs > 50 km).")

print("=" * 80)
