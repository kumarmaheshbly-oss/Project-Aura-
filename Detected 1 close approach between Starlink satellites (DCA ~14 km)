def parse_tle(tle_text):
    """TLE data ko parse karo"""
    lines = [l.strip() for l in tle_text.strip().split("\n") if l.strip()]
    satellites = []
    i = 0
    while i < len(lines):
        if lines[i].startswith("0 "):
            name = lines[i][2:].strip()
            if i+2 < len(lines):
                line1 = lines[i+1]
                line2 = lines[i+2]
                satellites.append({"name": name, "line1": line1, "line2": line2})
                i += 3
            else:
                break
        else:
            i += 1
    return satellites

def calculate_collision_risk(pos1, vel1, pos2, vel2):
    """Do satellites ke beech TTC aur DCA calculate karo"""
    r = [pos2[k] - pos1[k] for k in range(3)]
    v = [vel2[k] - vel1[k] for k in range(3)]
    
    v_sq = sum(x**2 for x in v)
    if v_sq == 0:
        return None
    
    r_dot_v = sum(r[k] * v[k] for k in range(3))
    tca = -r_dot_v / v_sq
    
    if tca < 0:
        return None
    
    future_r = [r[k] + v[k] * tca for k in range(3)]
    dca = math.sqrt(sum(x**2 for x in future_r))
    
    return tca, dca

