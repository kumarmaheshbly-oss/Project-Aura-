import os
import jdk4py
import jpype
import orekit_jpype

os.environ["JAVA_HOME"] = str(jdk4py.JAVA_HOME)

if not jpype.isJVMStarted():
    orekit_jar_dir = os.path.join(os.path.dirname(orekit_jpype.__file__), "jars")
    orekit_jar_path = os.path.join(orekit_jar_dir, "*")
    jpype.startJVM(classpath=[orekit_jar_path])
    print("JVM Started!")

from orekit_jpype.pyhelpers import download_orekit_data_curdir, setup_orekit_curdir
download_orekit_data_curdir()
setup_orekit_curdir()
print("Orekit Data setup done!")
from org.orekit.orbits import KeplerianOrbit, PositionAngleType
from org.orekit.frames import FramesFactory
from org.orekit.utils import Constants
from org.orekit.time import AbsoluteDate, TimeScalesFactory

print("✅ Saari Orekit classes successfully import ho gayi!")
# 1. Time set karein (20 March 2024, 12:00 UTC)
date = AbsoluteDate(2024, 3, 20, 12, 0, 0.0, TimeScalesFactory.getUTC())

# 2. Initial Orbit (ISS jaisa altitude aur inclination)
a = Constants.WGS84_EARTH_EQUATORIAL_RADIUS + 550000.0  # 550 km altitude
e = 0.0001
i = 0.9006  # ~51.6 degrees
omega = 0.0
raan = 0.0
lv = 0.0

initial_orbit = KeplerianOrbit(a, e, i, omega, raan, lv, 
                               PositionAngleType.TRUE,  # <--- Yahan badlaav kiya
                               FramesFactory.getEME2000(), 
                               date, 
                               Constants.WGS84_EARTH_MU)

# 3. Integrator Setup (Numerical Solver)
from org.hipparchus.ode.nonstiff import DormandPrince853Integrator
integrator = DormandPrince853Integrator(0.001, 1000.0, 1.0e-6, 1.0e-9)

# 4. Numerical Propagator banayein
from org.orekit.propagation.numerical import NumericalPropagator
propagator = NumericalPropagator(integrator)

# 5. Initial State set karein (Mass = 400 kg)
from org.orekit.propagation import SpacecraftState
initial_state = SpacecraftState(initial_orbit, 400.0)
propagator.setInitialState(initial_state)

print("✅ Numerical Propagator successfully ready hai!")
print("Ab hum isme RK_SpaceProbe (Drag Force) add karne ke liye taiyaar hain.")
from org.orekit.frames import FramesFactory
from org.orekit.utils import IERSConventions, Constants
from org.orekit.forces.gravity import HolmesFeatherstoneAttractionModel
from org.orekit.forces.gravity.potential import GravityFieldFactory

# 1. Earth ka ITRF frame banayein (Reference frame)
earth_frame = FramesFactory.getITRF(IERSConventions.IERS_2010, True)

# 2. Gravity model setup karein (Earth ka pull)
# 8x8 ka matlab hum Earth ki gravity field ke top 8 coefficients use kar rahe hain
gravity_provider = GravityFieldFactory.getNormalizedProvider(8, 8)
gravity_force = HolmesFeatherstoneAttractionModel(earth_frame, gravity_provider)

# 3. Propagator mein Gravity add karein
propagator.addForceModel(gravity_force)

print("✅ Gravity Force Model successfully add ho gaya!")
# 1. Time set karein: 1 ghante baad ka time (TCA ke liye)
date_plus_1hr = date.shiftedBy(3600.0) # 3600 seconds = 1 hour

# 2. Propagate karein (Numerical integration)
final_state = propagator.propagate(date_plus_1hr)

# 3. Naya position nikaalein
final_pv = final_state.getPVCoordinates()
new_pos = final_pv.getPosition()

print("🛰️ 1 Ghante Baad Satellite Ki Position (X, Y, Z) in km:")
print(f"X: {new_pos.getX() / 1000:.2f}")
print(f"Y: {new_pos.getY() / 1000:.2f}")
print(f"Z: {new_pos.getZ() / 1000:.2f}")
